# AI Ads Frontend Environment Variables
# In Cloud Run (or unified container), leave VITE_API_URL as /api (or unset) for same-origin routing.
# In local development with Vite proxy, /api is automatically proxied to http://127.0.0.1:5000.
VITE_API_URL=/api
VITE_BACKEND_TARGET=http://127.0.0.1:5000
VITE_UNIFIED_BACKEND_API=https://uwo24.com/api
VITE_APP_CODE=ai_ads
VITE_APP_KEY=key_ai_ads_live_master_2026
